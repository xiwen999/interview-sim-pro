# ===== 环境变量模板（本文件可入库；真实 .env 不入库）=====
# 用法：复制本文件为 server/.env 并填入真实值
#   cp server/.env.example server/.env
# server/index.js 启动时会自动读取 server/.env 注入以下变量，优先级高于 config.json

# --- 数据库（MySQL）---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=interview_sim

# --- AI 大模型代理（前端零配置，Key 只存服务端）---
# 留空则前端自动回退到本地智能模拟，不影响演示
# 默认对接讯飞 MaaS（OpenAI 兼容网关）；换其他网关时同步修改 AI_MODEL
AI_API_KEY=你的大模型APIKey（可选）
AI_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
AI_MODEL=spark-x2.6

# --- 邮件服务（注册邮箱验证码，SMTP）---
# 三项都留空 = 开发模式：验证码不真实发信，直接返回给前端自动填入，注册流程照常可用
# 需要真实发信时再填（QQ 邮箱示例：host=smtp.qq.com port=587，pass 填「设置-账户-开启SMTP」拿到的授权码）
# 注意：下面三项只要填了值，服务端就会尝试真实发信；填了假值会导致注册时报「邮件发送失败」
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 置 1 走 465 端口 SSL 直连；留空按端口自动判定（587 用 STARTTLS）
# SMTP_SSL=1

# --- 管理后台（仅首次建库时写入，之后改这里不影响已有账号）---
# 留空 ADMIN_PASSWORD 则首次启动自动生成 12 位随机密码并打印在控制台，推荐留空
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=

# --- 服务 ---
PORT=3000
# BIND_HOST=0.0.0.0   # 默认监听 0.0.0.0；仅本机演示可改为 127.0.0.1
